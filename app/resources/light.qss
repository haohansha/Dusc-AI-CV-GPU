/* Dusc AI - Industrial Detection Platform Brand QSS */
/* 主色：#1B5E3B 深绿 | 背景：#F5F6F8 | 卡片：#FFFFFF */

QMainWindow { background-color: #F5F6F8; }
QWidget { background-color: #FFFFFF; color: #1A1D21; font-size: 32px; }

/* === Tab 导航 === */
QTabWidget::pane { border: none; background: #F5F6F8; border-top: 1px solid #D5D8DC; }
QTabBar::tab { background: #FFFFFF; color: #5F6368; padding: 20px 40px; border: none; border-bottom: 3px solid transparent; font-size: 32px; }
QTabBar::tab:selected { background: #FFFFFF; border-bottom: 3px solid #1B5E3B; color: #1A1D21; font-weight: 600; }
QTabBar::tab:hover:!selected { color: #1A1D21; }

/* === 表格 === */
QTableWidget { background-color: #FFFFFF; color: #1A1D21; gridline-color: #EDF0F3; alternate-background-color: #F5F6F8; border: 1px solid #D5D8DC; border-radius: 8px; }
QHeaderView::section { background-color: #F5F6F8; color: #5F6368; padding: 20px 30px; border: none; border-bottom: 1px solid #D5D8DC; font-weight: 600; font-size: 30px; }

/* === 按钮 === */
QPushButton { background-color: #1B5E3B; color: #FFFFFF; border: none; border-radius: 2px; padding: 0 40px; height: 90px; font-size: 32px; font-weight: 500; }
QPushButton:hover { background-color: #15713A; }
QPushButton:pressed { background-color: #0F5A2E; }
QPushButton:disabled { background-color: #B0B5BB; color: #FFFFFF; }

/* === 输入控件 === */
QComboBox { background-color: #FFFFFF; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 2px; padding: 0 25px; height: 80px; font-size: 32px; }
QComboBox::drop-down { border: none; width: 50px; }
QComboBox QAbstractItemView { background-color: #FFFFFF; color: #1A1D21; selection-background-color: #E8F5EE; selection-color: #1B5E3B; border: 1px solid #D5D8DC; font-size: 32px; }

QLineEdit { background-color: #FFFFFF; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 2px; padding: 0 25px; height: 80px; font-size: 32px; }
QLineEdit:focus { border-color: #1B5E3B; }

QSpinBox { background-color: #FFFFFF; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 2px; padding: 0 25px; height: 80px; font-size: 32px; }
QDoubleSpinBox { background-color: #FFFFFF; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 2px; padding: 0 25px; height: 80px; font-size: 32px; }

QTextEdit { background-color: #EDF0F3; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 6px; padding: 30px; font-family: 'JetBrains Mono','Consolas',monospace; font-size: 30px; }

/* === 列表 === */
QListWidget { background-color: #FFFFFF; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 8px; padding: 10px; }
QListWidget::item { padding: 20px 30px; border-radius: 4px; font-size: 32px; }
QListWidget::item:selected { background-color: #E8F5EE; color: #1B5E3B; }
QListWidget::item:hover { background-color: #F0F2F5; }

/* === 分组框（保留兼容） === */
QGroupBox { background-color: #FFFFFF; border: 1px solid #D5D8DC; border-radius: 8px; margin-top: 30px; padding-top: 40px; color: #1A1D21; font-weight: 600; font-size: 38px; }
QGroupBox::title { subcontrol-origin: margin; left: 40px; padding: 0 20px; }

/* === 滑块 === */
QSlider::groove:horizontal { height: 10px; background: #EDF0F3; border-radius: 5px; }
QSlider::handle:horizontal { width: 40px; height: 40px; background: #1B5E3B; border-radius: 20px; margin: -15px 0; }
QSlider::handle:horizontal:hover { background: #15713A; }

/* === 进度条 === */
QProgressBar { background-color: #EDF0F3; border: none; border-radius: 10px; text-align: center; color: #1A1D21; height: 20px; font-size: 28px; }
QProgressBar::chunk { background-color: #1B5E3B; border-radius: 10px; }

/* === 工具栏 / 菜单 === */
QToolBar { background-color: #FFFFFF; border-bottom: 1px solid #D5D8DC; spacing: 20px; padding: 15px; }
QToolBar QToolButton { background-color: transparent; color: #5F6368; border: none; border-radius: 4px; padding: 15px 30px; font-size: 32px; }
QToolBar QToolButton:hover { background-color: #F0F2F5; color: #1A1D21; }

QMenuBar { background-color: #FFFFFF; color: #1A1D21; border-bottom: 1px solid #D5D8DC; padding: 10px; }
QMenuBar::item { background-color: transparent; padding: 15px 30px; border-radius: 4px; font-size: 32px; }
QMenuBar::item:selected { background-color: #F0F2F5; }

QMenu { background-color: #FFFFFF; color: #1A1D21; border: 1px solid #D5D8DC; border-radius: 6px; padding: 10px; }
QMenu::item { padding: 15px 80px 15px 30px; border-radius: 4px; font-size: 32px; }
QMenu::item:selected { background-color: #E8F5EE; color: #1B5E3B; }
QMenu::separator { height: 1px; background: #EDF0F3; margin: 10px 20px; }

/* === 状态栏 === */
QStatusBar { background-color: #FFFFFF; color: #8C9197; border-top: 1px solid #D5D8DC; font-size: 28px; padding: 8px; }
QStatusBar QLabel { color: #8C9197; font-size: 28px; }

/* === 滚动区域 === */
QScrollArea { background-color: #F5F6F8; border: none; }
QScrollBar:vertical { background: transparent; width: 25px; margin: 0; }
QScrollBar::handle:vertical { background: #D5D8DC; border-radius: 12px; min-height: 75px; }
QScrollBar::handle:vertical:hover { background: #B0B5BB; }
QScrollBar::add-line:vertical, QScrollBar::sub-line:vertical { height: 0; }
QScrollBar:horizontal { background: transparent; height: 25px; margin: 0; }
QScrollBar::handle:horizontal { background: #D5D8DC; border-radius: 12px; min-width: 75px; }
QScrollBar::handle:horizontal:hover { background: #B0B5BB; }
QScrollBar::add-line:horizontal, QScrollBar::sub-line:horizontal { width: 0; }

/* === 分割器 === */
QSplitter::handle { background-color: #EDF0F3; }
QSplitter::handle:hover { background-color: #D5D8DC; }

/* === 标签 === */
QLabel { color: #1A1D21; background-color: transparent; }

/* === 复选框 / 单选按钮 === */
QCheckBox { color: #1A1D21; background-color: transparent; spacing: 20px; font-size: 32px; }
QCheckBox::indicator { width: 40px; height: 40px; border: 1px solid #D5D8DC; border-radius: 8px; background: #FFFFFF; }
QCheckBox::indicator:checked { background-color: #1B5E3B; border-color: #1B5E3B; }

QRadioButton { color: #1A1D21; background-color: transparent; spacing: 20px; font-size: 32px; }
QRadioButton::indicator { width: 40px; height: 40px; border: 1px solid #D5D8DC; border-radius: 20px; background: #FFFFFF; }
QRadioButton::indicator:checked { background-color: #1B5E3B; border-color: #1B5E3B; }

/* === 消息框 === */
QMessageBox { background-color: #FFFFFF; }
QMessageBox QLabel { color: #1A1D21; font-size: 32px; }
QMessageBox QPushButton { min-width: 200px; min-height: 90px; }

/* === 对话框 === */
QDialog { background-color: #FFFFFF; }
